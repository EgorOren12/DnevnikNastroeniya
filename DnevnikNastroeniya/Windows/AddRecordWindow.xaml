<Window x:Class="DnevnikNastroeniya.Windows.AddRecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новая запись" Height="700" Width="600"
        MinHeight="500" MinWidth="400"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7F6">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Добавление записи" 
                   FontSize="22" 
                   FontWeight="Bold" 
                   Foreground="#2C3E50" 
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" 
                    Margin="0,0,0,10">
            <TextBlock Text="Дата:" 
                       FontWeight="SemiBold"/>
            <DatePicker x:Name="DpRecordDate" 
                        Height="30" 
                        Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" 
                    Margin="0,0,0,10">
            <TextBlock Text="Время:" 
                       FontWeight="SemiBold"/>
            <TextBox x:Name="TxtRecordTime" 
                     Height="30" 
                     Margin="0,5,0,0" 
                     VerticalContentAlignment="Center" 
                     Text="12:00:00"/>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Шкала:" 
                           FontWeight="SemiBold"/>
                <ComboBox x:Name="CmbMoodScale" 
                          Height="30" 
                          Margin="0,5,0,0" 
                          DisplayMemberPath="Name"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Уровень:" 
                           FontWeight="SemiBold"/>
                <TextBox x:Name="TxtMoodLevel" 
                         Height="30" 
                         Margin="0,5,0,0" 
                         VerticalContentAlignment="Center"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4" 
                    Margin="0,0,0,10">
            <TextBlock Text="Тег:" 
                       FontWeight="SemiBold"/>
            <ComboBox x:Name="CmbTag" 
                      Height="30" 
                      Margin="0,5,0,0" 
                      DisplayMemberPath="Name"/>
        </StackPanel>

        <StackPanel Grid.Row="5" 
                    Margin="0,0,0,10">
            <TextBlock Text="Фактор:" 
                       FontWeight="SemiBold"/>
            <ComboBox x:Name="CmbFactorType" 
                      Height="30" 
                      Margin="0,5,0,0" 
                      DisplayMemberPath="Name"/>
        </StackPanel>

        <StackPanel Grid.Row="6" 
                    Margin="0,0,0,10">
            <TextBlock Text="Комментарий:" 
                       FontWeight="SemiBold"/>
            <TextBox x:Name="TxtComment" 
                     Margin="0,5,0,0" 
                     Height="80" 
                     TextWrapping="Wrap" 
                     AcceptsReturn="True" 
                     VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <Button Grid.Row="7" 
                x:Name="BtnSave" 
                Content="Сохранить запись" 
                Height="40" 
                Background="#9ed883" 
                Foreground="White" 
                BorderThickness="0" 
                FontWeight="Bold" 
                Cursor="Hand"
                Click="BtnSave_Click"
                />
    </Grid>
</Window>