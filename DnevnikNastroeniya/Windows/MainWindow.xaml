<Window x:Class="DnevnikNastroeniya.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DnevnikNastroeniya.ViewModels"
        Title="Дневник Настроения" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F0F4F8">

    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate x:Key="TabHeaderTemplate">
            <Border x:Name="HeaderBorder" 
                    BorderBrush="#FFC5CAD0" 
                    BorderThickness="2" 
                    CornerRadius="5" 
                    Padding="15,5" 
                    Background="#E2E8F0">
                <TextBlock x:Name="HeaderText" 
                           Text="{Binding}" 
                           Foreground="#2C3E50" 
                           FontWeight="Bold" 
                           FontSize="14"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Value="True" 
                             Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}">
                    <Setter TargetName="HeaderBorder" 
                            Property="Background" 
                            Value="#9ed883"/>
                    <Setter TargetName="HeaderBorder" 
                            Property="BorderBrush" 
                            Value="#7CB362"/>
                    <Setter TargetName="HeaderText" 
                            Property="Foreground" 
                            Value="White"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" 
                Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Дневник Настроения" 
                           Foreground="White" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal">
                    <TextBlock Text="{Binding UserName, StringFormat={}{0} | }" 
                               Foreground="#BDC3C7" 
                               VerticalAlignment="Center" 
                               Margin="0,0,10,0"/>
                    <Button Content="Выйти" Command="{Binding LogoutCommand}" 
                            Background="#E74C3C" 
                            Foreground="White" 
                            BorderThickness="0" 
                            Padding="10,5" 
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" 
                    Margin="10" 
                    Background="White" 
                    BorderBrush="#DCDDE1">

            <TabItem Header="Главная" 
                     HeaderTemplate="{StaticResource TabHeaderTemplate}" 
                     Padding="0">
                <Grid Margin="20">
                    <StackPanel>
                        <TextBlock Text="Привет! Как твое настроение?" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="#2C3E50" 
                                   Margin="0,0,0,20"/>
                        <Border Background="#F8F9FA" 
                                BorderBrush="#E2E8F0" 
                                BorderThickness="1" 
                                CornerRadius="5" 
                                Padding="15" 
                                Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Последняя запись:" 
                                           FontSize="14" 
                                           FontWeight="SemiBold" 
                                           Foreground="#7F8C8D" 
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding LastRecordText}" 
                                           FontSize="16" 
                                           Foreground="#2C3E50" 
                                           FontStyle="Italic"/>
                            </StackPanel>
                        </Border>
                        <Button Content="+ Добавить новую запись" 
                                Command="{Binding AddRecordCommand}" 
                                Width="200" Height="40" 
                                HorizontalAlignment="Left" 
                                Background="#9ed883" 
                                Foreground="White" 
                                BorderThickness="0" 
                                FontWeight="Bold" 
                                Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Все записи" 
                     HeaderTemplate="{StaticResource TabHeaderTemplate}" 
                     Padding="0">
                <Grid Margin="20">
                    <StackPanel>
                        <TextBlock Text="История записей" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="#2C3E50" 
                                   Margin="0,0,0,20"/>
                        <ListBox ItemsSource="{Binding Records}" 
                                 Height="400" 
                                 BorderBrush="#DCDDE1" 
                                 BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="5">
                                        <TextBlock Text="{Binding Comment}" 
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Mood_Level, StringFormat=Настроение: {0}/10}" 
                                                   Foreground="#27AE60"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Прогнозы" 
                     HeaderTemplate="{StaticResource TabHeaderTemplate}" 
                     Padding="0">
                <Grid Margin="20">
                    <StackPanel>
                        <TextBlock Text="Нейросетевой прогноз" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="#2C3E50" 
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Анализ ваших последних записей с помощью DeepSeek AI." 
                                   Foreground="#7F8C8D" 
                                   Margin="0,0,0,20"/>

                        <Button Content="🔮 Сгенерировать прогноз" 
                                Command="{Binding GenerateForecastCommand}" 
                                Width="220" Height="40" 
                                HorizontalAlignment="Left" 
                                Background="#4A90E2" 
                                Foreground="White" 
                                BorderThickness="0" 
                                FontWeight="Bold" 
                                Cursor="Hand" 
                                Margin="0,0,0,20"/>

                        <Border Background="#F8F9FA" 
                                BorderBrush="#4A90E2" 
                                BorderThickness="2" 
                                CornerRadius="8" 
                                Padding="20">
                            <StackPanel>
                                <TextBlock Text="Результат анализа:" 
                                           FontSize="16" 
                                           FontWeight="Bold" 
                                           Foreground="#2C3E50" 
                                           Margin="0,0,0,10"/>

                                <TextBlock Text="{Binding ForecastText}" 
                                           FontSize="16" 
                                           FontWeight="Bold" 
                                           Foreground="#4A90E2" 
                                           TextWrapping="Wrap" 
                                           Margin="0,0,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Уверенность:" 
                                                   Foreground="#7F8C8D" 
                                                   FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ForecastConfidence}" 
                                                   FontSize="14" 
                                                   FontWeight="Bold" 
                                                   Foreground="#27AE60"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Состояние:" 
                                                   Foreground="#7F8C8D" 
                                                   FontSize="12" 
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ForecastState}" 
                                                   FontSize="14" 
                                                   FontWeight="Bold" 
                                                   Foreground="#E67E22"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Статистика" 
                     HeaderTemplate="{StaticResource TabHeaderTemplate}" 
                     Padding="0">
                <Grid Margin="20">
                    <StackPanel>
                        <TextBlock Text="Статистика настроения" 
                                   FontSize="24" 
                                   FontWeight="Bold"
                                   Foreground="#2C3E50"
                                   Margin="0,0,0,20"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>