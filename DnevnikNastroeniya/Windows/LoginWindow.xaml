<Window x:Class="DnevnikNastroeniya.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DnevnikNastroeniya"
        mc:Ignorable="d"
        Title="Авторизация" Height="370" Width="300"
        MinHeight="370" MaxHeight="370"
        MinWidth="300" MaxWidth="300"
        >
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="Авторизация" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,30" 
                       Foreground="#333"/>

            <TextBlock Text="Логин:" 
                       Margin="0,0,0,5" 
                       FontWeight="SemiBold"/>
            <TextBox x:Name="TxtLogin" 
                     Height="35" 
                     Padding="5" 
                     FontSize="14" 
                     VerticalContentAlignment="Center" 
                     Margin="0,0,0,15"/>

            <TextBlock Text="Пароль:" 
                       Margin="0,0,0,5" 
                       FontWeight="SemiBold"/>
            <PasswordBox x:Name="TxtPassword" 
                         Height="35" 
                         Padding="5" 
                         FontSize="14" 
                         VerticalContentAlignment="Center" 
                         Margin="0,0,0,25"/>

            <Button x:Name="BtnLogin" 
                    Content="Войти" 
                    Click="BtnLogin_Click"
                    Height="40" 
                    FontSize="16" 
                    Background="#9ed883" 
                    Foreground="White">

            </Button>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="Нет аккаунта? "
                           Grid.Column="0" 
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           />
                
                <TextBlock Text="Зарегистрируйтесь"
                           Grid.Column="1"
                           Name="RegistrationTextBlock"
                           MouseLeftButtonDown="RegistrationTextBlock_MouseLeftButtonDown"
                           HorizontalAlignment="Left"
                           Foreground="#6aa84d"
                           TextDecorations="Underline" 
                           FontWeight="Bold"
                           VerticalAlignment="Top"
                           MouseEnter="RegistrationTextBlock_MouseEnter"
                           MouseLeave="RegistrationTextBlock_MouseLeave"
                           />
            </Grid>
            
        </StackPanel>
    </Grid>
</Window>
